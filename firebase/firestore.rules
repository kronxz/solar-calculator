rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isValidAnonLeadWrite() {
      return request.auth == null
        && request.resource.data.userId == null
        && request.resource.data.nome is string
        && request.resource.data.telefone is string
        && request.resource.data.telefoneDigitos is string
        && request.resource.data.status is string
        && request.resource.data.status in ['Novo', 'Negociação']
        && request.resource.data.score is int
        && request.resource.data.score >= 0
        && request.resource.data.score <= 100
        && request.resource.data.temperatura is string
        && request.resource.data.ultima_acao_nome is string
        && request.resource.data.createdAt is timestamp
        && request.resource.data.lastAction is timestamp
        && request.resource.data.keys().hasOnly([
            'nome', 'telefone', 'telefoneDigitos', 'status', 'score', 'temperatura',
            'utm_source', 'utm_medium', 'utm_campaign', 'fbclid', 'gclid',
            'sessionId', 'bairroQR', 'dispositivo', 'pagina_origem',
            'createdAt', 'lastAction', 'ultima_acao_nome',
            'kits', 'kitEscolhido', 'sistemaEscolhido', 'investimento', 'geracao', 'economia',
            'valor', 'consumo', 'contaDeLuz', 'tarifa', 'hsp', 'consumoMensal', 'geracaoMensal',
            'kwp', 'placas', 'inversor', 'potenciaPlaca', 'overload', 'payback', 'atualizadoEm'
          ]);
    }

    function isValidAnonTimelineWrite() {
      return request.auth == null
        && request.resource.data.tipo is string
        && request.resource.data.nome is string
        && request.resource.data.criadoEm is timestamp
        && request.resource.data.sessionId is string
        && request.resource.data.meta is map
        && request.resource.data.keys().hasOnly([
            'tipo', 'nome', 'criadoEm', 'sessionId', 'meta'
          ]);
    }

    // LEADS
    match /leads/{leadId} {

      allow create: if request.auth != null || isValidAnonLeadWrite();

      allow update: if request.auth != null || isValidAnonLeadWrite();

      allow read, delete: if request.auth != null;

      match /timeline/{eventId} {
        allow create: if request.auth != null || isValidAnonTimelineWrite();
        allow read: if request.auth != null;
      }
    }

    // EVENTOS
    match /eventos/{eventoId} {

      allow create:
      if true;

      allow read:
      if request.auth != null;
    }

    // CONFIG CRM
    match /crm_config/{userId} {

      allow read, write:
      if request.auth != null;
    }
  }
}
